<%
  // One section of a page: either the classic image layout (gallery) or a
  // "layout canvas" board with freely placed layers.
  // Called as: include('partials/section', { section }) — the helpers below
  // are on app.locals, the same ones the admin preview mirrors.
%>
<%
  const __s = section;
  const __canvas = (__s.layout || 'gallery') === 'canvas';
  const __layers = (__s.layers || []).filter(l => l && l.hidden !== true);
  const __h = Number(__s.canvasHeight) > 0 ? Math.min(Math.max(Number(__s.canvasHeight), 200), 4000) : 720;
  const __w = Number(__s.canvasWidth) > 0 ? Math.min(4000, Math.max(480, Math.round(Number(__s.canvasWidth)))) : 1425;
  // safeColor() only lets plain CSS colours through, so a stray value can never
  // break out of the style attribute on the board below.
  const __bg = canvasBackground(__s.canvasBg);
  const __img = __s.canvasImage ? esc(safeUrl(__s.canvasImage)) : '';
  const __bgColor = __img ? esc(__bg.color) : esc(safeColor(__s.canvasBg) || 'transparent');
  const __bgAlpha = __img ? __bg.alpha : 1;
  const __place = (value) => {
    const n = Number(value);
    return Number.isFinite(n) ? Math.min(100, Math.max(0, Math.round(n))) : 50;
  };
%>
<% if (__s.layout === 'case') { %>
  <section class="content-section case-study"<% if (__s.heading) { %> aria-label="<%= __s.heading %>"<% } %>>
    <% if (__s.heading) { %><h2 class="section-heading reveal"><%= __s.heading %></h2><% } %>
    <% if (__s.role) { %><p class="case-role reveal"><%= __s.role %></p><% } %>
    <% if (__s.brief) { %>
      <div class="case-block reveal"><h3>Brief</h3><div class="section-text"><%- paragraphs(__s.brief) %></div></div>
    <% } %>
    <% if (__s.process) { %>
      <div class="case-block reveal"><h3>Process</h3><div class="section-text"><%- paragraphs(__s.process) %></div></div>
    <% } %>
    <% if (__s.outcome) { %>
      <div class="case-block reveal"><h3>Outcome</h3><div class="section-text"><%- paragraphs(__s.outcome) %></div></div>
    <% } %>
  </section>
<% } else if (__canvas) { %>
  <section class="content-section layout-canvas<%= __s.canvasLock ? ' canvas-lock' : '' %>"
    style="--canvas-h: <%= __h %>; --canvas-w: <%= __w %>; --canvas-bg: <%= __bgColor %>; --canvas-bg-alpha: <%= __bgAlpha %><% if (__img) { %>; --canvas-image: url('<%= __img %>'); --canvas-image-x: <%= __place(__s.canvasImageX) %>%; --canvas-image-y: <%= __place(__s.canvasImageY) %>%<% } %>"
    <% if (__s.heading) { %>aria-label="<%= __s.heading %>"<% } %>>
    <div class="canvas-board">
      <% __layers.forEach(function (l) {
           const name = l.name || l.type;
           const anim = animationAttrs(l);
           const animate = (anim || l.anim === 'float' || l.anim === 'pulse')
             ? (l.animated === false ? '' : ' canvas-anim')
             : '';
           const box = layerBox(l, __h);
           const style = styleToCss(l);
      %>
        <div class="layer layer-<%= l.type %><%= animate ? ' is-animated' : '' %>"
             style="<%= box %>"
             data-layer="<%= name ? esc(name) : '' %>"
             <%- anim %>>
          <div class="layer-turn" style="<%= turnStyle(l) %>">
          <% if (l.type === 'heading') { %>
            <h2 class="layer-heading" style="<%= style %>"><%- layerText(l.text) %></h2>
          <% } else if (l.type === 'text' || l.type === 'paragraph') { %>
            <div class="layer-text<%= (l.type === 'paragraph' || l.paragraph) ? ' is-paragraph' : '' %>" style="<%= style %>"><%- paragraphs(l.text) %></div>
          <% } else if (l.type === 'image') { %>
            <% if (l.src) { %>
              <% const __rad = Math.min(Math.max(Number(l.radius) || 0, 0), 500); %>
              <% if (l.link) { %><a href="<%= safeUrl(l.link) %>"<% if (isExternal(l.link)) { %> target="_blank" rel="noopener"<% } %> class="layer-link"><% } %>
              <span class="layer-frame" style="border-radius:<%= __rad %>px">
              <% if (/\.(mp4|webm)(\?|$)/i.test(l.src)) { %>
                <video class="layer-media" src="<%= safeUrl(l.src) %>" muted loop playsinline controls style="object-fit:<%= LAYER_FITS.has(l.fit) ? l.fit : 'cover' %>;border-radius:<%= __rad %>px"></video>
              <% } else { %>
                <img class="layer-media" src="<%= safeUrl(l.src) %>" alt="<%= l.alt || '' %>" loading="lazy" style="object-fit:<%= LAYER_FITS.has(l.fit) ? l.fit : 'cover' %>;border-radius:<%= __rad %>px">
              <% } %>
              </span>
              <% if (l.link) { %></a><% } %>
            <% } %>
          <% } else if (l.type === 'group') { %>
            <div class="layer-group">
              <% (l.children || []).forEach(function (c) {
                   const cx = Math.round(Number(c.x) || 0);
                   const cy = Math.round(Number(c.y) || 0);
                   const cw = Math.max(1, Math.round(Number(c.w) || 1));
                   const ch = Math.max(1, Math.round(Number(c.h) || 1));
              %>
                <div class="layer-group-child" style="left:<%= cx %>px;top:<%= cy %>px;width:<%= cw %>px;height:<%= ch %>px;">
                  <% if (c.type === 'image' && c.src) { %>
                    <img src="<%= safeUrl(c.src) %>" alt="<%= c.alt || '' %>" style="object-fit:<%= c.fit === 'contain' || c.fit === 'fill' ? c.fit : 'cover' %>">
                  <% } else if (c.type === 'heading') { %>
                    <div class="layer-heading"><%- layerText(c.text) %></div>
                  <% } else if (c.type === 'text' || c.type === 'paragraph') { %>
                    <div class="layer-text<%= (c.type === 'paragraph' || c.paragraph) ? ' is-paragraph' : '' %>"><%- paragraphs(c.text) %></div>
                  <% } else if (c.type === 'shape') { %>
                    <span class="layer-shape" style="background:<%= esc(safeColor(c.bg) || '#E1E5EB') %>"></span>
                  <% } %>
                </div>
              <% }) %>
            </div>
          <% } else if (l.type === 'gallery' && l.freeform) { %>
            <div class="layer-free">
              <% (l.images || []).forEach(function (item, i) {
                   const fx = Math.round(Number(item.x) || 0);
                   const fy = Math.round(Number(item.y) || 0);
                   const fw = Math.max(10, Math.round(Number(item.w) || 80));
                   const fh = Math.max(10, Math.round(Number(item.h) || 80));
              %>
                <button class="zoom gallery-tile layer-free-item" type="button"
                        style="left:<%= fx %>px;top:<%= fy %>px;width:<%= fw %>px;height:<%= fh %>px"
                        data-full="<%= safeUrl(item.image) %>"
                        data-caption="<%= item.caption || '' %>"
                        data-link="<%= safeUrl(item.link) %>"
                        aria-label="<%= item.caption || 'Enlarge image' %>">
                  <img src="<%= safeUrl(item.image) %>" alt="<%= item.caption || '' %>" loading="lazy"
                       style="object-fit:<%= LAYER_FITS.has(l.fit) ? l.fit : 'cover' %>">
                </button>
              <% }) %>
            </div>
          <% } else if (l.type === 'gallery') { %>
            <% const imgs = (l.images || []);
               const galAspect = String(l.aspect || 'natural');
               const galRatio = galAspect !== 'natural' ? galAspect.replace(':', ' / ') : ''; %>
            <ul class="layer-gallery cols-<%= Math.min(Math.max(Number(l.columns) || 3, 1), 4) %> aspect-<%= galAspect.replace(':', 'x') %>"
                style="gap:<%= Math.min(Math.max(Number(l.gap) || 16, 0), 120) %>px">
              <% imgs.forEach(function (item, i) { %>
                <li>
                  <button class="zoom gallery-tile" type="button"
                          style="<%= galRatio ? 'aspect-ratio:' + galRatio : '' %>"
                          data-full="<%= safeUrl(item.image) %>"
                          data-caption="<%= item.caption || '' %>"
                          data-link="<%= safeUrl(item.link) %>"
                          aria-label="<%= item.caption || 'Enlarge image' %>">
                    <img src="<%= safeUrl(item.image) %>" alt="<%= item.caption || '' %>" loading="lazy"
                         style="object-fit:<%= LAYER_FITS.has(l.fit) ? l.fit : 'cover' %>">
                    <span class="tile-overlay">
                      <span class="tile-num"><%= String(i + 1).padStart(2, '0') %></span>
                      <% if (item.caption) { %><span class="tile-caption"><%- lines(item.caption) %></span><% } %>
                    </span>
                  </button>
                </li>
              <% }) %>
            </ul>
          <% } else if (l.type === 'youtube') { %>
            <% const __yt = l.youtubeId || youtubeId(l.src); %>
            <% if (__yt) { %>
              <iframe class="layer-embed" title="<%= l.name || 'YouTube video' %>"
                src="https://www.youtube-nocookie.com/embed/<%= __yt %>"
                allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture; web-share"
                allowfullscreen loading="lazy"></iframe>
            <% } %>
          <% } else if (l.type === 'pdf') { %>
            <% if (l.src) { %>
              <iframe class="layer-embed" title="<%= l.name || 'PDF' %>" src="<%= safeUrl(l.src) %>" loading="lazy"></iframe>
            <% } %>
          <% } else if (l.type === 'button') { %>
            <span class="layer-button-slot" style="justify-content:<%= LAYER_ALIGN.has(l.align) ? (l.align === 'center' ? 'center' : l.align === 'right' ? 'flex-end' : 'flex-start') : 'flex-start' %>">
              <a class="layer-button style-<%= ['pill', 'solid', 'outline'].includes(l.buttonStyle) ? l.buttonStyle : 'pill' %>"
                 href="<%= safeUrl(l.link) || '#' %>"
                 style="<%= style %>"
                 <% if (l.newTab !== false && isExternal(l.link)) { %>target="_blank" rel="noopener"<% } %>><%= l.text || 'Read more' %></a>
            </span>
          <% } else if (l.type === 'divider') { %>
            <span class="layer-divider" style="background:<%= esc(safeColor(l.color) || '#0A192F') %>;border-radius:<%= Math.min(Math.max(Number(l.radius) || 0, 0), 500) %>px"></span>
          <% } else if (l.type === 'shape') { %>
            <% if (shapeKindOf(l) === 'rect') { %>
              <span class="layer-shape" style="<%= style %><%= l.bg ? '' : ';background:#E1E5EB' %>"></span>
            <% } else { %>
              <%- shapeMarkup(l) %>
            <% } %>
          <% } %>
          </div>
          <% if (l.type === 'image' && l.subtitle) { %>
            <span class="layer-subtitle" style="text-align:<%= ['left','center','right'].includes(l.subtitleAlign) ? l.subtitleAlign : 'center' %>"><%= l.subtitle %></span>
          <% } %>
        </div>
      <% }) %>
    </div>
  </section>
<% } else { %>
  <%
    const items = __s.items || [];
    const aspect = __s.aspect || 'natural';
    const cols = Math.min(Math.max(Number(__s.columns) || 3, 1), 4);
  %>
  <section class="content-section align-<%= __s.align || 'left' %> layout-<%= __s.layout || 'gallery' %>"<% if (safeColor(__s.bg)) { %> style="background:<%= esc(safeColor(__s.bg)) %>"<% } %>>
    <% if (__s.heading) { %><h2 class="section-heading reveal"><%- lines(__s.heading) %></h2><% } %>
    <% if (__s.text) { %><div class="section-text reveal"><%- paragraphs(__s.text) %></div><% } %>

    <% if (items.length) { %>
      <ul class="items cols-<%= cols %> aspect-<%= aspect.replace(':', 'x') %>">
        <% items.forEach(function (item, i) { %>
          <li class="item reveal<% if (item.wide) { %> wide<% } %>">
            <button class="zoom gallery-tile" type="button" data-full="<%= safeUrl(item.image) %>" data-caption="<%= item.caption %>" data-link="<%= safeUrl(item.link) %>" aria-label="<%= item.caption || 'Enlarge image' %>">
              <img src="<%= safeUrl(item.image) %>" alt="<%= item.caption %>" loading="lazy">
              <span class="tile-overlay">
                <span class="tile-num"><%= String(i + 1).padStart(2, '0') %></span>
                <% if (item.caption) { %><span class="tile-caption"><%- lines(item.caption) %></span><% } %>
              </span>
            </button>
          </li>
        <% }) %>
      </ul>
    <% } %>

    <% if (__s.textAfter) { %><div class="section-text after reveal"><%- paragraphs(__s.textAfter) %></div><% } %>

    <% if ((__s.buttons || []).length) { %>
      <div class="section-buttons">
        <% __s.buttons.forEach(function (b) { %>
          <a class="pill-button" href="<%= safeUrl(b.url) %>"<% if (isExternal(b.url)) { %> target="_blank" rel="noopener"<% } %>><%= b.label %></a>
        <% }) %>
      </div>
    <% } %>
  </section>
<% } %>
