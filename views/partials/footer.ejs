<footer class="site-footer">
  <div class="footer-inner">
    <div class="footer-left">
      <h6 class="footer-name"><%= site.name %></h6>
      <p class="footer-copy"><%= site.copyright %></p>
    </div>
    <div class="footer-right">
      <h6 class="footer-contact-title"><%= site.footerContactTitle %></h6>
      <p><a href="mailto:<%= site.email %>"><%= site.email %></a></p>
      <%- include('socials', { site }) %>
    </div>
  </div>
</footer>

<dialog class="work-popup" aria-labelledby="work-popup-title">
  <button class="work-popup-close" type="button" aria-label="Close">&times;</button>
  <img class="work-popup-cover" alt="" hidden>
  <p class="work-popup-num"></p>
  <p class="work-popup-meta"></p>
  <h2 class="work-popup-title" id="work-popup-title"></h2>
  <ul class="work-popup-tags" hidden></ul>
  <p class="work-popup-intro"></p>
</dialog>

<div class="lightbox" hidden aria-modal="true" role="dialog" aria-label="Image viewer">
  <button class="lb-close" type="button" aria-label="Close">&times;</button>
  <button class="lb-prev" type="button" aria-label="Previous">&#8249;</button>
  <figure>
    <img alt="">
    <figcaption></figcaption>
  </figure>
  <button class="lb-next" type="button" aria-label="Next">&#8250;</button>
</div>

<script src="/js/site.js?v=cache15" defer></script>
</body>
</html>
