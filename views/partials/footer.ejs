<footer class="site-footer">
  <div class="footer-inner">
    <div class="footer-left">
      <h6 class="footer-name"><%= site.name %></h6>
      <p class="footer-copy"><%= site.copyright %></p>
    </div>
    <div class="footer-right">
      <h6 class="footer-contact-title"><%= site.footerContactTitle %></h6>
      <p><a href="mailto:<%= site.email %>"><%= site.email %></a></p>
      <%- include('socials', { site }) %>
    </div>
  </div>
</footer>

<dialog class="work-popup">
  <div class="work-case">
    <div class="work-case-copy">
      <p class="work-case-category" hidden></p>
      <h2 class="work-case-title" id="work-popup-title" hidden></h2>
      <p class="work-case-intro" hidden></p>
      <ul class="work-case-tags" hidden></ul>
      <dl class="work-case-facts" hidden></dl>
      <div class="work-case-sections"></div>
    </div>
    <div class="work-case-pieces" tabindex="-1" aria-label="Pieces"></div>
  </div>
  <button class="work-popup-close" type="button" autofocus aria-label="Close">&times;</button>
</dialog>

<div class="lightbox" hidden aria-modal="true" role="dialog" aria-label="Image viewer">
  <button class="lb-close" type="button" aria-label="Close">&times;</button>
  <button class="lb-prev" type="button" aria-label="Previous">&#8249;</button>
  <figure>
    <img alt="">
    <figcaption></figcaption>
  </figure>
  <button class="lb-next" type="button" aria-label="Next">&#8250;</button>
</div>

<script src="/js/site.js?v=cache21" defer></script>
</body>
</html>
