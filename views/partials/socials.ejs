<%
  const icons = {
    instagram: { label: 'Instagram', bg: '#E1306C', svg: '<rect x="6" y="6" width="12" height="12" rx="3.5" fill="none" stroke="#fff" stroke-width="1.6"/><circle cx="12" cy="12" r="2.9" fill="none" stroke="#fff" stroke-width="1.6"/><circle cx="15.4" cy="8.6" r="0.9" fill="#fff"/>' },
    x: { label: 'X', bg: '#000', svg: '<path d="M7.2 7h2.9l2.4 3.3L15.3 7h1.4l-3.6 4.2L17 17h-2.9l-2.6-3.6L8.4 17H7l3.9-4.6z" fill="#fff"/>' },
    facebook: { label: 'Facebook', bg: '#1877F2', svg: '<path d="M13.2 18v-5h1.7l.3-2h-2V9.8c0-.6.2-1 1-1h1.1V7.1a14 14 0 0 0-1.6-.1c-1.6 0-2.6 1-2.6 2.7V11H9.4v2h1.7v5z" fill="#fff"/>' },
    youtube: { label: 'YouTube', bg: '#FF0000', svg: '<path d="M10.2 9.2v5.6l4.8-2.8z" fill="#fff"/>' },
    behance: { label: 'Behance', bg: '#1769FF', svg: '<text x="12" y="15.5" font-size="8" font-family="Arial" font-weight="700" fill="#fff" text-anchor="middle">Bē</text>' },
    linkedin: { label: 'LinkedIn', bg: '#0A66C2', svg: '<text x="12" y="15.8" font-size="8.5" font-family="Arial" font-weight="700" fill="#fff" text-anchor="middle">in</text>' },
    tiktok: { label: 'TikTok', bg: '#000', svg: '<path d="M13 6.5h1.8c.2 1.3 1 2.2 2.4 2.3v1.8c-.9 0-1.7-.3-2.4-.7v3.8a3.3 3.3 0 1 1-3.3-3.3v1.8a1.5 1.5 0 1 0 1.5 1.5z" fill="#fff"/>' },
    pixiv: { label: 'pixiv', bg: '#0096FA', svg: '<text x="12" y="15.8" font-size="9" font-family="Arial" font-weight="700" fill="#fff" text-anchor="middle">P</text>' },
    email: { label: 'Email', bg: '#4F5E75', svg: '<rect x="6.5" y="8" width="11" height="8" rx="1" fill="none" stroke="#fff" stroke-width="1.4"/><path d="M7 8.6l5 4 5-4" fill="none" stroke="#fff" stroke-width="1.4"/>' },
    website: { label: 'Website', bg: '#0A192F', svg: '<circle cx="12" cy="12" r="5.5" fill="none" stroke="#fff" stroke-width="1.4"/><path d="M6.5 12h11M12 6.5c2 2.2 2 8.8 0 11M12 6.5c-2 2.2-2 8.8 0 11" fill="none" stroke="#fff" stroke-width="1.2"/>' }
  };
%>
<ul class="socials">
  <% (site.socials || []).forEach(s => { const ic = icons[s.type] || icons.website; %>
    <li>
      <a href="<%= s.url %>" target="_blank" rel="noopener" aria-label="<%= ic.label %>">
        <svg viewBox="0 0 24 24" width="27" height="27" aria-hidden="true"><circle cx="12" cy="12" r="12" fill="<%= ic.bg %>"/><%- ic.svg %></svg>
      </a>
    </li>
  <% }) %>
</ul>
