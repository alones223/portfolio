<a class="skip-link" href="#main">Skip to main content</a>
<%# Refraction map for the liquid-glass bar. Used only where backdrop-filter accepts an SVG filter (Chromium). %>
<svg class="lg-defs" width="0" height="0" aria-hidden="true" focusable="false" style="position:absolute">
  <filter id="lg-refract" x="0" y="0" width="100%" height="100%" color-interpolation-filters="sRGB">
    <feTurbulence type="fractalNoise" baseFrequency="0.006 0.05" numOctaves="2" seed="7" result="noise"/>
    <feGaussianBlur in="noise" stdDeviation="2" result="map"/>
    <feDisplacementMap in="SourceGraphic" in2="map" scale="16" xChannelSelector="R" yChannelSelector="G"/>
  </filter>
</svg>
<header class="site-header">
  <div class="header-inner">
    <a class="logo" href="/" aria-label="<%= site.name %> — Home">
      <% if (site.logo) { %><img src="<%= site.logo %>" alt="<%= site.name %> logo" width="81" height="81"><% } %>
    </a>
    <button class="nav-toggle" type="button" aria-expanded="false" aria-controls="site-nav" aria-label="Menu">
      <span></span><span></span><span></span>
    </button>
    <nav id="site-nav" class="site-nav" aria-label="Site">
      <ul>
        <% nav.forEach(item => { %>
          <li><a href="<%= item.href %>"<% if (item.active) { %> class="active" aria-current="location"<% } %>><%= item.label %></a></li>
        <% }) %>
      </ul>
    </nav>
  </div>
</header>
