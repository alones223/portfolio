<%- include('partials/head', { site, pageTitle }) %>
<body class="home">
<%- include('partials/header', { site, nav }) %>

<main id="main">
  <% const aboutSection = (home.sections || []).find(function (s) { return s && s.id === 's-about-canvas'; }); %>
  <% const worksId = home.works && home.works.id; %>

  <div id="home" class="page-anchor">
  <!-- Hero: a layout canvas when Home → Hero is in canvas edit, otherwise the
       original name / tagline / big word. -->
  <% if (home.hero && home.hero.layout === 'canvas') { %>
    <%- include('partials/section', { section: home.hero }) %>
  <% } else { %>
  <section class="hero" style="--hero-image: url('<%= home.hero.image %>')">
    <div class="hero-text">
      <h1 class="hero-name reveal"><%= home.hero.name %></h1>
      <h2 class="hero-tagline reveal"><%= home.hero.tagline %></h2>
    </div>
    <p class="hero-bigword" aria-hidden="true"><%= home.hero.bigWord %></p>
  </section>
  <% } %>

  <!-- Home sections, except About (its own tab) and the old Works canvas (Works is a cell grid, not that canvas). -->
  <% (home.sections || []).forEach(function (section) { %>
    <% const skip = section && ((aboutSection && section.id === aboutSection.id) || (worksId && section.id === worksId)); %>
    <% if (!skip) { %>
    <%- include('partials/section', { section }) %>
    <% } %>
  <% }) %>
  </div>

  <section id="works" class="works-slot page-anchor" data-filter="all" aria-labelledby="works-title">
    <h2 id="works-title" class="title-highlight"><span>Works</span></h2>
    <% const workCards = (home.works && home.works.cards) || []; %>
    <%
      const featuredCards = [];
      workCards.forEach(function (card, index) {
        if (featuredCards.length >= 3) return;
        const kind = ['image', 'text', 'youtube', 'pdf'].indexOf(card.blockType) >= 0 ? card.blockType : 'work';
        if (kind === 'work' && card.featured === true) featuredCards.push({ card: card, index: index });
      });
    %>
    <% if (featuredCards.length) { %>
    <ul class="works-features">
      <% featuredCards.forEach(function (item) { %>
      <%
        const card = item.card;
        const title = card.title || card.label || '';
        const num = String(item.index + 1).padStart(2, '0');
      %>
      <li>
        <button type="button" class="works-feature"
          data-work-index="<%= item.index %>"
          data-num="<%= num %>"
          data-title="<%= title %>"
          data-category="<%= card.category || '' %>"
          data-year="<%= card.year || '' %>"
          data-intro="<%= card.intro || '' %>"
          data-image="<%= card.image || '' %>"
          data-tags="<%= JSON.stringify(Array.isArray(card.tags) ? card.tags : []) %>">
          <% if (card.image) { %><img src="<%= card.image %>" alt=""><% } %>
          <span class="works-feature-mark">Feature Work</span>
          <span class="works-card-copy">
            <% if (title) { %><span class="works-card-title"><%= title %></span><% } %>
            <span class="works-view">View Project</span>
          </span>
        </button>
      </li>
      <% }); %>
    </ul>
    <% } %>
    <%
      const workTags = [];
      workCards.forEach(function (card) {
        const list = Array.isArray(card.tags) ? card.tags : [];
        list.forEach(function (tag) {
          if (tag && workTags.indexOf(tag) < 0) workTags.push(tag);
        });
      });
    %>
    <% if (workCards.length) { %>
    <div class="works-tags" role="group" aria-label="Tags">
      <button type="button" class="works-tag" data-tag="" aria-pressed="true">All</button>
      <% workTags.forEach(function (tag) { %>
      <button type="button" class="works-tag" data-tag="<%= tag %>" aria-pressed="false"><%= tag %></button>
      <% }); %>
    </div>
    <div class="works-cells-wrap">
    <ul class="works-cells">
      <% workCards.forEach(function (card, index) { %>
      <%
        const cellSize = /^[1-3]x[1-3]$/.test(card.size) ? card.size : '1x1';
        const kind = ['image', 'text', 'youtube', 'pdf'].indexOf(card.blockType) >= 0 ? card.blockType : 'work';
        const num = String(index + 1).padStart(2, '0');
        const title = card.title || card.label || '';
        const category = card.category || '';
        const year = card.year || '';
        const intro = card.intro || '';
        const tags = Array.isArray(card.tags) ? card.tags : [];
        let youtube = '';
        if (kind === 'youtube') {
          const match = String(card.youtube || '').match(/(?:youtu\.be\/|youtube\.com\/(?:watch\?v=|embed\/|shorts\/))([\w-]{11})/);
          youtube = match ? match[1] : '';
        }
      %>
      <li class="works-cell" data-size="<%= cellSize %>" data-kind="<%= kind %>" data-work-index="<%= index %>" data-tags="<%= JSON.stringify(tags) %>">
        <p class="works-num"><%= num %></p>
        <% if (kind === 'work') { %>
        <button type="button" class="works-open"
          data-num="<%= num %>"
          data-title="<%= title %>"
          data-category="<%= category %>"
          data-year="<%= year %>"
          data-intro="<%= intro %>"
          data-image="<%= card.image || '' %>"
          data-tags="<%= JSON.stringify(tags) %>">
          <% if (card.image) { %><img src="<%= card.image %>" alt=""><% } %>
          <span class="works-card-copy">
            <% if (category || year) { %>
            <span class="works-card-meta">
              <% if (category) { %><span><%= category %></span><% } %>
              <% if (year) { %><span><%= year %></span><% } %>
            </span>
            <% } %>
            <% if (title) { %><span class="works-card-title"><%= title %></span><% } %>
            <% if (intro) { %><span class="works-card-intro"><%= intro %></span><% } %>
            <span class="works-view">View Project</span>
          </span>
        </button>
        <% } else if (kind === 'image') { %>
          <% if (card.image) { %><img src="<%= card.image %>" alt="<%= title %>"><% } %>
        <% } else if (kind === 'text') { %>
          <div class="works-cell-copy"><%= card.text || '' %></div>
        <% } else if (kind === 'youtube' && youtube) { %>
          <iframe src="https://www.youtube-nocookie.com/embed/<%= youtube %>" title="<%= title || 'YouTube' %>" allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture" allowfullscreen></iframe>
        <% } else if (kind === 'pdf' && card.pdf) { %>
          <iframe src="<%= card.pdf %>" title="<%= title || 'PDF' %>"></iframe>
        <% } else { %>
          <div class="works-cell-copy"><%= title || card.youtube || card.pdf || '' %></div>
        <% } %>
      </li>
      <% }); %>
    </ul>
    </div>
    <% } %>
  </section>

  <div id="about" class="page-anchor">
    <% if (aboutSection) { %>
      <%- include('partials/section', { section: aboutSection }) %>
    <% } %>
  </div>

  <section class="contact page-anchor" id="contact">
    <div class="contact-info reveal">
      <h3><%= home.contact.heading %></h3>
      <%- paragraphs(home.contact.text) %>
      <p class="contact-email"><%= home.contact.emailLine %></p>
      <%- include('partials/socials', { site }) %>
    </div>
    <form class="contact-form reveal" action="/contact" method="post" novalidate>
      <label>
        <span><%= home.contact.labelName %> <i>*</i></span>
        <input type="text" name="name" required maxlength="200" autocomplete="name">
      </label>
      <label>
        <span><%= home.contact.labelEmail %> <i>*</i></span>
        <input type="email" name="email" required maxlength="200" autocomplete="email">
      </label>
      <label>
        <span><%= home.contact.labelSubject %> <i>*</i></span>
        <input type="text" name="subject" required maxlength="300">
      </label>
      <label>
        <span><%= home.contact.labelMessage %> <i>*</i></span>
        <textarea name="message" required maxlength="5000" rows="4"></textarea>
      </label>
      <label class="hp" aria-hidden="true">Website <input type="text" name="website" tabindex="-1" autocomplete="off"></label>
      <button type="submit"><%= home.contact.labelSubmit %></button>
      <p class="form-status" role="status" data-success="<%= home.contact.successMessage %>"></p>
    </form>
  </section>

  <section class="marquee" aria-label="<%= home.marquee %>">
    <div class="marquee-track" aria-hidden="true">
      <% for (let i = 0; i < 8; i++) { %><span><%= home.marquee %> • </span><% } %>
    </div>
  </section>

  <% (pages || []).forEach(function (page) { %>
  <div id="<%= page.slug %>" class="page-anchor">
    <%- include('partials/page-block', { page }) %>
  </div>
  <% }) %>
</main>

<%- include('partials/footer', { site }) %>
