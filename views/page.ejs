<%- include('partials/head', { site, pageTitle }) %>
<body class="subpage">
<%- include('partials/header', { site, nav }) %>

<main id="main">
  <section class="page-hero"<% if (page.heroImage) { %> style="--hero-image: url('<%= page.heroImage %>')"<% } %>>
    <div class="page-hero-inner">
      <h2 class="title-highlight page-title reveal"><span><%= page.title %></span></h2>
      <span class="page-hero-rule" aria-hidden="true"></span>
      <% if (page.subtitle) { %><h6 class="page-subtitle reveal"><%= page.subtitle %></h6><% } %>
    </div>
  </section>

  <% if (page.kind === 'case') { %>
    <section class="content-section case-study">
      <% if (page.role) { %><p class="case-role"><%= page.role %></p><% } %>
      <dl class="case-grid">
        <% if (page.brief) { %>
          <div>
            <dt>Brief</dt>
            <dd class="section-text"><%- paragraphs(page.brief) %></dd>
          </div>
        <% } %>
        <% if (page.process) { %>
          <div>
            <dt>Process</dt>
            <dd class="section-text"><%- paragraphs(page.process) %></dd>
          </div>
        <% } %>
        <% if (page.outcome) { %>
          <div>
            <dt>Outcome</dt>
            <dd class="section-text"><%- paragraphs(page.outcome) %></dd>
          </div>
        <% } %>
      </dl>
    </section>
  <% } %>

  <% (page.sections || []).forEach(function (section) { %>
    <%- include('partials/section', { section }) %>
  <% }) %>
</main>

<%- include('partials/footer', { site }) %>
